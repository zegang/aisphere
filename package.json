{
  "name": "aisphere",
  "version": "0.0.1",
  "type": "module",
  "description": "AiSphere Desktop - Your Versatile Local AI",
  "main": "dist-electron/main.js",
  "homepage": "https://github.com/zegangluo/aisphere",
  "author": "AiSphere Team <zegang.luo@qq.com>",
  "license": "MIT",
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "dev:clean": "rm -rf node_modules/.vite",
    "dev": "yarn dev:clean && concurrently \"vite\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "tsc && vite build && electron-builder",
    "build:dir": "tsc && vite build && electron-builder --dir",
    "build:win": "tsc && vite build && electron-builder --win",
    "build:mac": "tsc && vite build && electron-builder --mac",
    "build:linux": "tsc && vite build && electron-builder --linux",
    "preview": "vite build && vite preview",
    "electron:dev": "vite",
    "electron:build": "tsc && vite build && electron-builder",
    "lic": "license-checker > THIRD_PARTYL_ICENSES",
    "lic:md": "license-checker --markdown > THIRD_PARTYL_ICENSES.md",
    "lic:full": "license-checker --markdown --include-licenses > THIRD_PARTY_LICENSES_FULL.md"
  },
  "dependencies": {
    "electron-updater": "^6.3.0",
    "i18next": "^26.1.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "immer": "^10.1.1",
    "lowdb": "^7.0.1",
    "lucide-react": "^1.14.0",
    "node-pty": "^1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.7",
    "react-router-dom": "^7.1.1",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@electron/fuses": "^1.8.0",
    "@tailwindcss/typography": "^0.5.15",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "license-checker": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwind-scrollbar": "^3.1.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6",
    "wait-on": "^8.0.1"
  }
}
